{
  "identifier": "mobile",
  "description": "Permissions for mobile (Android / iOS) features",
  "platforms": ["android", "iOS"],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    {
      "identifier": "http:default",
      "allow": [
        "https://unm-api.prod.gbclstudio.cn/*",
        "https://ncm-api.prod.gbclstudio.cn/*",
        "https://lyric-atlas-api.prod.gbclstudio.cn/*"
      ]
    },
    "log:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "media-session:default",
    "orientation:allow-set-screen-orientation",
    "pinia:default"
  ]
}
