<?xml version="1.0" encoding="utf-8"?>
<!--
  Transport-button glyph while a track is being prepared.

  Static by necessity: notification actions render a plain alpha mask, so an
  AnimatedVectorDrawable would not spin. The motion the user actually sees is
  the system spinner that `STATE_BUFFERING` puts in the platform media
  controls; this only has to make the notification's own button agree with it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M12,4 a8,8 0 1 1 -5.66,2.34"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2.4" />
</vector>
