<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon: the app logo (vinyl record + note) as a monochrome
  silhouette.

  Android draws the small icon as an alpha mask tinted with the notification
  colour, so this cannot be the launcher icon — a full-colour bitmap renders as
  a solid block. Traced from `public/images/logo/favicon.svg`: the record body
  is punched out at the label radius (`evenOdd`) so it reads as a ring rather
  than a disc at 24dp, with the spindle hole kept as a separate dot.

  A host app can override this by shipping its own `drawable/ic_notification`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="1152"
    android:viewportHeight="1152">
    <group
        android:translateX="64"
        android:translateY="64">
        <!-- Record body: outer edge, hollowed at the label. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M511.764091,131.708086 a446.145957,446.145957 0 1 0 446.145957,446.145957 a446.145957,446.145957 0 0 0 -446.145957,-446.145957 z M511.764091,386.457428 a186.935156,186.935156 0 1 0 186.935156,186.48901 a186.935156,186.935156 0 0 0 -186.935156,-186.935156 z" />
        <!-- Spindle hole, kept solid so the centre does not read as empty. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M511.764091,651.021980 a71.383353,71.383353 0 1 1 71.383353,-71.383353 a71.383353,71.383353 0 0 1 -71.383353,71.383353 z" />
        <!-- Note stem and flag. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M802.205109 0.541175l-168.197026 37.030114a67.814185 67.814185 0 0 0-53.091369 66.029602V223.614153l3.569168 349.778431h114.213365V223.614153h108.859613a26.322611 26.322611 0 0 0 26.768758-26.322611V26.863786a26.768757 26.768757 0 0 0-32.122509-26.322611z" />
    </group>
</vector>
